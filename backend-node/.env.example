# Environment Variables — STUDLYF HR Backend

# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
DATABASE_URL="postgresql://postgres.gwwxborogqzchwsowuob:<YOUR_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.gwwxborogqzchwsowuob:<YOUR_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ─── Supabase JS Client (Storage, Realtime, etc.) ────────────────────────────
SUPABASE_URL="your_supabase_url"
SUPABASE_API_KEY="your_supabase_api_key"

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET="your_super_secret_jwt_key_min_32_chars"
JWT_REFRESH_SECRET="your_super_secret_refresh_key_min_32_chars"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID="your_github_oauth_app_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_app_client_secret"
GITHUB_REDIRECT_URI="http://localhost:3001/api/auth/github/callback"

# ─── Google OAuth (sign-in only — not used for sending email) ────────────────
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google/callback"

# ─── Calendly ────────────────────────────────────────────────────────────────
CALENDLY_API_TOKEN="your_calendly_personal_access_token"
CALENDLY_USER_URI="https://api.calendly.com/users/YOUR_USER_UUID"
CALENDLY_WEBHOOK_SECRET="your_calendly_webhook_signing_secret"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Resend is the only email provider. HR-initiated mail is sent as
# "{HR Name} via STUDLYF" <RESEND_SENDER_ADDRESS>, with Reply-To set to the HR's
# own email address so candidate replies go straight to the HR and never pass
# back through STUDLYF.
#
# Get your API key at https://resend.com — free tier: 3,000 emails/month
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Address STUDLYF sends from. Must belong to a domain verified in Resend.
# onboarding@resend.dev works for testing but only delivers to the email that
# owns the Resend account — swap it for a verified domain address in production.
RESEND_SENDER_ADDRESS="onboarding@resend.dev"

# From header for platform mail (signup / password-reset OTPs). No HR attribution.
RESEND_FROM="STUDLYF HR <onboarding@resend.dev>"

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL="http://localhost:3000"
ENVIRONMENT="development"
